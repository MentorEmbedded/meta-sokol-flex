From f70a8d09c174e8c376491ed7c3f850d25b274504 Mon Sep 17 00:00:00 2001
From: Haseeb Ashraf <haseeb.ashraf@siemens.com>
Date: Thu, 22 Oct 2026 10:06:00 +0500
Subject: [PATCH 06/10] tools: Open a window for every display head

mks only showed the first screen of a VM. A VM with several virtio-gpu
outputs exports one QEMU console, and so one MksScreen, per output, so
every head but the first was unusable.

Create one window per screen, ordered by head number, and quit once the
last window is closed. Add --head=N (repeatable) to show only the given
heads. Command line parsing moves to GOptionContext, which also
provides --help; the bus address stays the first positional argument.

Upstream-Status: Pending
Signed-off-by: Haseeb Ashraf <haseeb.ashraf@siemens.com>
---
 tools/mks.c | 184 +++++++++++++++++++++++++++++++++++++++++-----------
 1 file changed, 145 insertions(+), 39 deletions(-)

diff --git a/tools/mks.c b/tools/mks.c
index 291e307..6e15d08 100644
--- a/tools/mks.c
+++ b/tools/mks.c
@@ -20,20 +20,34 @@
 
 #include "config.h"
 
+#include <stdlib.h>
 #include <unistd.h>
 
 #include <gtk/gtk.h>
 #include <libmks.h>
 
+typedef struct
+{
+  GMainLoop *main_loop;
+  guint      n_windows;
+} MksApp;
+
+static char **opt_heads;
+
+static const GOptionEntry entries[] = {
+  { "head", 'H', 0, G_OPTION_ARG_STRING_ARRAY, &opt_heads,
+    "Only show this guest display head (repeatable, default: all)", "N" },
+  { NULL }
+};
+
 static GDBusConnection *
-create_connection (int      argc,
-                   char   **argv,
-                   GError **error)
+create_connection (const char  *address,
+                   GError     **error)
 {
-  if (argc < 2)
+  if (address == NULL)
     return g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, error);
   else
-    return g_dbus_connection_new_for_address_sync (argv[1], G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, error);
+    return g_dbus_connection_new_for_address_sync (address, G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, error);
 }
 
 static gboolean
@@ -54,46 +68,136 @@ update_title_binding (GBinding     *binding,
   return TRUE;
 }
 
+static gboolean
+head_selected (guint number)
+{
+  if (opt_heads == NULL)
+    return TRUE;
+
+  for (guint i = 0; opt_heads[i] != NULL; i++)
+    {
+      if (g_ascii_strtoull (opt_heads[i], NULL, 10) == number)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gint
+compare_screens (gconstpointer a,
+                 gconstpointer b)
+{
+  MksScreen *screen_a = *(MksScreen * const *)a;
+  MksScreen *screen_b = *(MksScreen * const *)b;
+  guint number_a = mks_screen_get_number (screen_a);
+  guint number_b = mks_screen_get_number (screen_b);
+
+  return (number_a > number_b) - (number_a < number_b);
+}
+
+/* Returns the screens (display heads) of the VM ordered by head number. */
+static GPtrArray *
+collect_screens (MksSession *session)
+{
+  GPtrArray *screens = g_ptr_array_new_with_free_func (g_object_unref);
+  GListModel *devices = mks_session_get_devices (session);
+  guint n_devices = g_list_model_get_n_items (devices);
+
+  for (guint i = 0; i < n_devices; i++)
+    {
+      g_autoptr(MksDevice) device = g_list_model_get_item (devices, i);
+
+      if (MKS_IS_SCREEN (device) &&
+          head_selected (mks_screen_get_number (MKS_SCREEN (device))))
+        g_ptr_array_add (screens, g_object_ref (device));
+    }
+
+  g_ptr_array_sort (screens, compare_screens);
+
+  return screens;
+}
+
+static gboolean
+on_close_request (GtkWindow *window,
+                  gpointer   user_data)
+{
+  MksApp *app = user_data;
+
+  if (app->n_windows > 0)
+    app->n_windows--;
+
+  if (app->n_windows == 0)
+    g_main_loop_quit (app->main_loop);
+
+  return FALSE;
+}
+
+static void
+create_window (MksApp    *app,
+               MksScreen *screen)
+{
+  GtkWindow *window;
+  GtkWidget *display;
+  GdkSurface *surface;
+
+  window = g_object_new (GTK_TYPE_WINDOW,
+                         "default-width", 1280,
+                         "default-height", 768,
+                         "title", "Mouse, Keyboard, Screen",
+                         NULL);
+
+  display = mks_display_new ();
+  mks_display_set_screen (MKS_DISPLAY (display), screen);
+  gtk_window_set_child (window, display);
+
+  g_signal_connect (window, "close-request", G_CALLBACK (on_close_request), app);
+  app->n_windows++;
+
+  gtk_window_present (window);
+
+  surface = gtk_native_get_surface (GTK_NATIVE (window));
+  g_object_bind_property_full (surface, "shortcuts-inhibited",
+                               window, "title",
+                               G_BINDING_SYNC_CREATE,
+                               update_title_binding, NULL, display, NULL);
+}
+
 int
 main (int   argc,
       char *argv[])
 {
+  g_autoptr(GOptionContext) context = NULL;
   g_autoptr(GDBusConnection) connection = NULL;
   g_autoptr(MksSession) session = NULL;
-  g_autoptr(MksScreen) screen = NULL;
-  g_autoptr(GMainLoop) main_loop = NULL;
+  g_autoptr(GPtrArray) screens = NULL;
   g_autoptr(GError) error = NULL;
-  GtkWindow *window;
-  GtkWidget *display;
+  MksApp app = { 0 };
   GtkSettings *settings;
-  GdkSurface *surface;
+  const char *address = NULL;
 
-  gtk_init ();
-  mks_init ();
+  context = g_option_context_new ("[BUS-ADDRESS]");
+  g_option_context_set_summary (context,
+                                "Show the displays of a QEMU D-Bus display.\n"
+                                "Without BUS-ADDRESS the session bus is used.");
+  g_option_context_add_main_entries (context, entries, NULL);
 
-  if (!(connection = create_connection (argc, argv, &error)))
+  if (!g_option_context_parse (context, &argc, &argv, &error))
     {
-      g_printerr ("Failed to connect to D-Bus: %s\n", error->message);
+      g_printerr ("%s\n", error->message);
       return EXIT_FAILURE;
     }
 
-  main_loop = g_main_loop_new (NULL, FALSE);
+  if (argc > 1)
+    address = argv[1];
 
-  window = g_object_new (GTK_TYPE_WINDOW,
-                         "default-width", 1280,
-                         "default-height", 768,
-                         "title", "Mouse, Keyboard, Screen",
-                         NULL);
-
-  settings = gtk_settings_get_default ();
-  g_object_set (settings, "gtk-application-prefer-dark-theme", TRUE, NULL);
+  gtk_init ();
+  mks_init ();
 
-  display = mks_display_new ();
-  gtk_window_set_child (window, display);
-  g_signal_connect_swapped (window,
-                            "close-request",
-                            G_CALLBACK (g_main_loop_quit),
-                            main_loop);
+  if (!(connection = create_connection (address, &error)))
+    {
+      g_printerr ("Failed to connect to D-Bus: %s\n", error->message);
+      return EXIT_FAILURE;
+    }
 
   if (!(session = mks_session_new_for_connection_sync (connection, NULL, &error)))
     {
@@ -101,23 +205,25 @@ main (int   argc,
       return EXIT_FAILURE;
     }
 
-  if (!(screen = mks_session_ref_screen (session)))
+  screens = collect_screens (session);
+
+  if (screens->len == 0)
     {
-      g_printerr ("No screen attached to session!\n");
+      g_printerr ("No matching screen attached to session!\n");
       return EXIT_FAILURE;
     }
 
-  mks_display_set_screen (MKS_DISPLAY (display), screen);
+  settings = gtk_settings_get_default ();
+  g_object_set (settings, "gtk-application-prefer-dark-theme", TRUE, NULL);
 
-  gtk_window_present (window);
+  app.main_loop = g_main_loop_new (NULL, FALSE);
 
-  surface = gtk_native_get_surface (GTK_NATIVE (window));
-  g_object_bind_property_full (surface, "shortcuts-inhibited",
-                               window, "title",
-                               G_BINDING_SYNC_CREATE,
-                               update_title_binding, NULL, display, NULL);
+  for (guint i = 0; i < screens->len; i++)
+    create_window (&app, g_ptr_array_index (screens, i));
+
+  g_main_loop_run (app.main_loop);
 
-  g_main_loop_run (main_loop);
+  g_main_loop_unref (app.main_loop);
 
   return EXIT_SUCCESS;
 }
