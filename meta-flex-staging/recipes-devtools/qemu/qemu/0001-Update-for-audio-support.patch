+/*
+ * Handles VIRTIO_SND_R_CTL_INFO.
+ *
+ * @s: VirtIOSound device
+ * @cmd: The request command queue element from VirtIOSound cmdq field
+ */
+static void virtio_snd_handle_ctl_info(VirtIOSound *s,
+                                          virtio_snd_ctrl_command *cmd)
+{
+    uint32_t start_id, control_id, count, size;
+    struct virtio_snd_ctl_info val;
+    struct virtio_snd_query_info req;
+    g_autofree struct virtio_snd_ctl_info *ctl_info_array = NULL;
+    size_t msg_sz = iov_to_buf(cmd->elem->out_sg,
+                               cmd->elem->out_num,
+                               0,
+                               &req,
+                               sizeof(struct virtio_snd_query_info));
+
+    if (msg_sz != sizeof(struct virtio_snd_query_info)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                "%s: virtio-snd command size incorrect %zu vs \
+                %zu\n", __func__, msg_sz, sizeof(struct virtio_snd_query_info));
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return;
+    }
+
+    start_id = le32_to_cpu(req.start_id);
+    count = le32_to_cpu(req.count);
+    size = le32_to_cpu(req.size);
+
+    if (iov_size(cmd->elem->in_sg, cmd->elem->in_num) <
+        sizeof(virtio_snd_hdr) + size * count) {
+        error_report("sound control info: buffer too small, got: %zu, needed: %zu",
+                iov_size(cmd->elem->in_sg, cmd->elem->in_num),
+                sizeof(virtio_snd_hdr) + size * count);
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return;
+    }
+
+    /* Only provide info on controls we know about */
+    count = (count + start_id) > VIRTIO_SOUND_CONTROLS_COUNT ? VIRTIO_SOUND_CONTROLS_COUNT - start_id : count;
+
+    ctl_info_array = g_new0(struct virtio_snd_ctl_info, count);
+    for (uint32_t i = 0; i < count; i++) {
+        control_id = i + start_id;
+        trace_virtio_snd_handle_ctl_info(control_id);
+
+        val = audio_controls[control_id];
+        val.hdr.hda_fn_nid = cpu_to_le32(val.hdr.hda_fn_nid);
+        val.role = cpu_to_le32(val.role);
+        val.type = cpu_to_le32(val.type);
+        val.access = cpu_to_le32(val.access);
+        val.count = cpu_to_le32(val.count);
+        val.index = cpu_to_le32(val.index);
+        val.value.integer.min = cpu_to_le32(val.value.integer.min);
+        val.value.integer.max = cpu_to_le32(val.value.integer.max);
+        val.value.integer.step = cpu_to_le32(val.value.integer.step);
+        ctl_info_array[i] = val;
+    }
+
+    cmd->payload_size = sizeof(struct virtio_snd_ctl_info) * count;
+    cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_OK);
+    iov_from_buf(cmd->elem->in_sg,
+                 cmd->elem->in_num,
+                 sizeof(virtio_snd_hdr),
+                 ctl_info_array,
+                 cmd->payload_size);
+}
+
+/*
+ * Handles VIRTIO_SND_R_CTL_READ.
+ *
+ * @s: VirtIOSound device
+ * @cmd: The request command queue element from VirtIOSound cmdq field
+ */
+static void virtio_snd_handle_ctl_read(VirtIOSound *s,
+                                          virtio_snd_ctrl_command *cmd)
+{
+    struct virtio_snd_ctl_hdr req;
+    struct virtio_snd_ctl_value val;
+    uint32_t control_id;
+    size_t msg_sz = iov_to_buf(cmd->elem->out_sg,
+                               cmd->elem->out_num,
+                               0,
+                               &req,
+                               sizeof(struct virtio_snd_ctl_hdr));
+
+    if (msg_sz != sizeof(struct virtio_snd_ctl_hdr)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                "%s: virtio-snd ctl read size incorrect %zu vs \
+                %zu\n", __func__, msg_sz, sizeof(struct virtio_snd_ctl_hdr));
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return;
+    }
+
+    control_id = le32_to_cpu(req.control_id);
+    trace_virtio_snd_handle_ctl_read(control_id);
+
+    if (control_id >= VIRTIO_SOUND_CONTROLS_COUNT) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                "%s: virtio-snd ctl read for unknown control, id %u \n"\
+                , __func__, control_id);
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return;
+    }
+
+    switch (control_id){
+        case VOLUME_CONTROL_INPUT_ID:
+            val.value.integer[0] = cpu_to_le32(s->volume_control_input_val);
+        break;
+         case VOLUME_CONTROL_OUTPUT_ID:
+            val.value.integer[0] = cpu_to_le32(s->volume_control_output_val);
+        break;
+        case MUTE_CONTROL_INPUT_ID:
+            val.value.integer[0] = cpu_to_le32(s->mute_control_input_val);
+        break;
+       case MUTE_CONTROL_OUTPUT_ID:
+            val.value.integer[0] = cpu_to_le32(s->mute_control_output_val);
+        break;
+    }
+
+    cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_OK);
+    iov_from_buf(cmd->elem->in_sg,
+                 cmd->elem->in_num,
+                 sizeof(virtio_snd_hdr),
+                 &val,
+                 sizeof(struct virtio_snd_ctl_value));
+}
+
+/*
+ * Sets volume and mute status on all streams matching 'direction'.
+ *
+ * @s: VirtIOSound device
+ * @direction: VIRTIO_SND_D_INPUT or VIRTIO_SND_D_OUTPUT
+ * @mute: mute boolean state of streams in 'direction'
+ * @volume: volume level between 0 and 100 of streams in 'direction'
+ */
+static void virtio_snd_set_stream_volume(VirtIOSound *s, uint8_t direction, uint32_t mute, uint32_t volume)
+{
+    VirtIOSoundPCMStream *stream;
+    /* Convert percentage volume to 0-255 */
+    uint32_t stream_volume = (255 * volume) / 100;
+
+    for (int i = 0; i < s->snd_conf.streams; i++) {
+        stream = virtio_snd_pcm_get_stream(s, i);
+
+        if (stream && stream->info.direction == direction) {
+            switch(direction) {
+            case VIRTIO_SND_D_OUTPUT:
+                audio_be_set_volume_out_lr(s->audio_be, stream->voice.out, mute, (uint8_t)stream_volume, (uint8_t)stream_volume);
+                break;
+            case VIRTIO_SND_D_INPUT:
+                audio_be_set_volume_in_lr(s->audio_be, stream->voice.in, mute, (uint8_t)stream_volume, (uint8_t)stream_volume);
+                break;
+            default:
+                break;
+            }
+        }
+    }
+}
+
+/*
+ * Handles VIRTIO_SND_R_CTL_WRITE.
+ *
+ * @s: VirtIOSound device
+ * @cmd: The request command queue element from VirtIOSound cmdq field
+ */
+static void virtio_snd_handle_ctl_write(VirtIOSound *s,
+                                          virtio_snd_ctrl_command *cmd)
+{
+    struct virtio_snd_ctl_hdr req;
+    struct virtio_snd_ctl_value val;
+    uint32_t control_id, local_value;
+    uint32_t volume, mute, update = 0;
+    uint8_t direction;
+    size_t msg_sz = iov_to_buf(cmd->elem->out_sg,
+                               cmd->elem->out_num,
+                               0,
+                               &req,
+                               sizeof(struct virtio_snd_ctl_hdr));
+
+    if (msg_sz != sizeof(struct virtio_snd_ctl_hdr)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                "%s: virtio-snd ctl write request size incorrect %zu vs \
+                %zu\n", __func__, msg_sz, sizeof(struct virtio_snd_ctl_hdr));
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return;
+    }
+
+    control_id = le32_to_cpu(req.control_id);
+    trace_virtio_snd_handle_ctl_write(control_id);
+
+    if (control_id >= VIRTIO_SOUND_CONTROLS_COUNT) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                "%s: virtio-snd ctl read for unknown control, id %u \n"\
+                , __func__, control_id);
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return;
+    }
+
+    msg_sz = iov_to_buf(cmd->elem->out_sg,
+                               cmd->elem->out_num,
+                               sizeof(struct virtio_snd_ctl_hdr),
+                               &val,
+                               sizeof(struct virtio_snd_ctl_value));
+
+    if (msg_sz != sizeof(struct virtio_snd_ctl_value)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                "%s: virtio-snd ctl write payload size incorrect %zu vs \
+                %zu\n", __func__, msg_sz, sizeof(struct virtio_snd_ctl_value));
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return;
+    }
+
+    local_value = le32_to_cpu(val.value.integer[0]);
+    switch (control_id){
+        case VOLUME_CONTROL_INPUT_ID:
+            if (local_value != s->volume_control_input_val) {
+                volume = s->volume_control_input_val = local_value;
+                mute = s->mute_control_input_val;
+                direction = VIRTIO_SND_D_INPUT;
+                update = 1;
+            }
+        break;
+        case VOLUME_CONTROL_OUTPUT_ID:
+            if (local_value != s->volume_control_output_val) {
+                volume = s->volume_control_output_val = local_value;
+                mute = s->mute_control_output_val;
+                direction = VIRTIO_SND_D_OUTPUT;
+                update = 1;
+            }
+        break;
+        case MUTE_CONTROL_INPUT_ID:
+            if (local_value != s->mute_control_input_val) {
+                volume = s->volume_control_input_val;
+                mute = s->mute_control_input_val = local_value;
+                direction = VIRTIO_SND_D_INPUT;
+                update = 1;
+            }
+        break;
+        case MUTE_CONTROL_OUTPUT_ID:
+            if (local_value != s->mute_control_output_val) {
+                volume = s->volume_control_output_val;
+                mute = s->mute_control_output_val = local_value;
+                direction = VIRTIO_SND_D_OUTPUT;
+                update = 1;
+            }
+        break;
+    }
+
+    if (update)
+        virtio_snd_set_stream_volume(s, direction, mute, volume);
+
+    cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_OK);
+}
