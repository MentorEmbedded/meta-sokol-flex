diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index f6ddaf2c..ce8d8e30 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -33,6 +33,7 @@
 #include <unistd.h>
 #ifndef _WIN32
 #include <sys/mman.h>
+#include <sys/sysmacros.h>
 #else
 #include "mman_win32.h"
 #endif
@@ -219,6 +220,29 @@ static int get_drm_fd(void)
 #endif
 }
 
+/* Identify the DRM node used by vrend so that the render server can pick the
+ * same GPU for venus.
+ */
+static void get_drm_device(uint32_t *out_major, uint32_t *out_minor)
+{
+#ifndef WIN32
+   int fd = get_drm_fd();
+   struct stat st;
+
+   if (fd < 0)
+      return;
+
+   if (!fstat(fd, &st) && S_ISCHR(st.st_mode)) {
+      *out_major = major(st.st_rdev);
+      *out_minor = minor(st.st_rdev);
+   }
+   close(fd);
+#else
+   (void)out_major;
+   (void)out_minor;
+#endif
+}
+
 int virgl_renderer_context_create_with_flags(uint32_t ctx_id,
                                              uint32_t ctx_flags,
                                              uint32_t nlen,
@@ -933,7 +957,11 @@ int virgl_renderer_init(void *cookie, int flags, struct virgl_renderer_callbacks
    }
 
    if (!state.proxy_initialized && (flags & VIRGL_RENDERER_RENDER_SERVER)) {
-      ret = proxy_renderer_init(&proxy_cbs, flags | VIRGL_RENDERER_NO_VIRGL);
+      uint32_t drm_major = 0, drm_minor = 0;
+      get_drm_device(&drm_major, &drm_minor);
+
+      ret = proxy_renderer_init(&proxy_cbs, flags | VIRGL_RENDERER_NO_VIRGL, drm_major,
+                                drm_minor);
       if (ret) {
          virgl_error("failed to initialize venus renderer");
          goto fail;
