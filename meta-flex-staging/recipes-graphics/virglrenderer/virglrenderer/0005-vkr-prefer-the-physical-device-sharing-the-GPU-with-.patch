diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index e2c3baa5..ef14767a 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -11,6 +11,85 @@
 #include "vkr_device.h"
 #include "vkr_instance.h"
 
+static struct {
+   uint32_t major;
+   uint32_t minor;
+} vkr_preferred_drm_device;
+
+void
+vkr_renderer_set_preferred_drm_device(uint32_t major, uint32_t minor)
+{
+   vkr_preferred_drm_device.major = major;
+   vkr_preferred_drm_device.minor = minor;
+}
+
+static bool
+vkr_physical_device_handle_matches_drm(const struct vn_physical_device_proc_table *vk,
+                                       VkPhysicalDevice handle,
+                                       uint32_t major,
+                                       uint32_t minor)
+{
+   uint32_t count = 0;
+   if (vk->EnumerateDeviceExtensionProperties(handle, NULL, &count, NULL) != VK_SUCCESS ||
+       !count)
+      return false;
+
+   VkExtensionProperties *exts = calloc(count, sizeof(*exts));
+   if (!exts)
+      return false;
+
+   bool has_drm = false;
+   if (vk->EnumerateDeviceExtensionProperties(handle, NULL, &count, exts) >= VK_SUCCESS) {
+      for (uint32_t i = 0; i < count; i++) {
+         if (!strcmp(exts[i].extensionName, VK_EXT_PHYSICAL_DEVICE_DRM_EXTENSION_NAME)) {
+            has_drm = true;
+            break;
+         }
+      }
+   }
+   free(exts);
+   if (!has_drm)
+      return false;
+
+   VkPhysicalDeviceDrmPropertiesEXT drm_props = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRM_PROPERTIES_EXT,
+   };
+   VkPhysicalDeviceProperties2 props2 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+      .pNext = &drm_props,
+   };
+   vk->GetPhysicalDeviceProperties2(handle, &props2);
+
+   return (drm_props.hasRender && drm_props.renderMajor == major &&
+           drm_props.renderMinor == minor) ||
+          (drm_props.hasPrimary && drm_props.primaryMajor == major &&
+           drm_props.primaryMinor == minor);
+}
+
+/* Return the index of the physical device matching the preferred DRM node,
+ * or -1.
+ */
+static int
+vkr_instance_find_preferred_physical_device(struct vkr_instance *instance,
+                                            const VkPhysicalDevice *handles,
+                                            uint32_t count)
+{
+   const uint32_t major = vkr_preferred_drm_device.major;
+   const uint32_t minor = vkr_preferred_drm_device.minor;
+   if (!major)
+      return -1;
+
+   struct vn_physical_device_proc_table vk;
+   vn_util_init_physical_device_proc_table(instance->base.handle.instance,
+                                           instance->get_proc_addr, &vk);
+
+   for (uint32_t i = 0; i < count; i++) {
+      if (vkr_physical_device_handle_matches_drm(&vk, handles[i], major, minor))
+         return (int)i;
+   }
+   return -1;
+}
+
 #ifdef HAVE_LINUX_UDMABUF_H
 #include <fcntl.h>
 
@@ -126,6 +205,18 @@ vkr_instance_enumerate_physical_devices(struct vkr_instance *instance)
       return result;
    }
 
+   /* Move the device sharing the GPU with the client's EGL/GBM to the front, so
+    * that guest WSI buffers can be imported by the host compositor path
+    * without crossing GPUs.
+    */
+   const int preferred =
+      vkr_instance_find_preferred_physical_device(instance, handles, count);
+   if (preferred > 0) {
+      const VkPhysicalDevice tmp = handles[preferred];
+      memmove(&handles[1], &handles[0], sizeof(*handles) * (uint32_t)preferred);
+      handles[0] = tmp;
+   }
+
    instance->physical_device_count = count;
    instance->physical_device_handles = handles;
    instance->physical_devices = physical_devs;
@@ -472,6 +563,25 @@ vkr_dispatch_vkEnumeratePhysicalDeviceGroups(
    if (!orig_props)
       return;
 
+   /* keep group order consistent with the physical device order */
+   if (instance->physical_device_count && vkr_preferred_drm_device.major) {
+      const VkPhysicalDevice first = instance->physical_device_handles[0];
+      for (uint32_t i = 1; i < *args->pPhysicalDeviceGroupCount; i++) {
+         const VkPhysicalDeviceGroupProperties *props =
+            &args->pPhysicalDeviceGroupProperties[i];
+         bool found = false;
+         for (uint32_t j = 0; j < props->physicalDeviceCount; j++)
+            found |= props->physicalDevices[j] == first;
+         if (found) {
+            const VkPhysicalDeviceGroupProperties tmp = *props;
+            memmove(&args->pPhysicalDeviceGroupProperties[1],
+                    &args->pPhysicalDeviceGroupProperties[0], sizeof(tmp) * i);
+            args->pPhysicalDeviceGroupProperties[0] = tmp;
+            break;
+         }
+      }
+   }
+
    /* TODO avoid requiring venus driver to call vkEnumeratePhysicalDevices first */
    /* replace VkPhysicalDevice handles by object ids */
    for (uint32_t i = 0; i < *args->pPhysicalDeviceGroupCount; i++) {
