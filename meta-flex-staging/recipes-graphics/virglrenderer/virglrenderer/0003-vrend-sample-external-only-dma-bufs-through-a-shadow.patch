+            vrend_sync_make_current(ctx->sub->gl_context);
+            if (!gr->egl_external_shadow)
+               virgl_warn("%s: res %u is external-only but the external copy "
+                          "program is unavailable\n", __func__, res_id);
+         }
+         if (gr->egl_external_shadow)
+            virgl_debug("%s: res %u is external-only, using shadow texture\n",
+                        __func__, res_id);
+
          ret = vrend_resource_alloc_texture(gr, virgl_format, gr->egl_image);
          if (ret) {
+            if (gr->egl_external_id)
+               glDeleteTextures(1, &gr->egl_external_id);
             virgl_egl_image_destroy(egl, gr->egl_image);
             FREE(gr);
             return ret;
