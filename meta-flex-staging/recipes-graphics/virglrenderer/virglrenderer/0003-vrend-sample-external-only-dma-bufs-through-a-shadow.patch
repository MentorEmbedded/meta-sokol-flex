diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 8d99e234..69b4b585 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -404,6 +404,9 @@ struct global_renderer_state {
 #endif
    bool d3d_share_texture : 1;
    bool gbm_layout_feat : 1;
+
+   /* incremented for each command buffer submission */
+   uint64_t submit_seq;
 };
 
 struct sysval_uniform_block {
@@ -2307,6 +2310,34 @@ void vrend_sync_make_current(virgl_gl_context gl_cxt) {
    glDeleteSync(sync);
 }
 
+void vrend_renderer_begin_submit(void)
+{
+   vrend_state.submit_seq++;
+}
+
+/* Resources whose dmabuf import is external-only (e.g. LINEAR on NVIDIA) are
+ * sampled through an EXTERNAL_OES texture and copied into the regular gl_id
+ * shadow texture before they are read by the guest context.
+ *
+ * The dma-buf is written by another device or API, and the guest has to
+ * synchronize with that writer before it submits commands that read the
+ * resource, so the shadow only needs to be refreshed once per command
+ * submission. Reads outside of a submission (transfers) pass force. */
+static void vrend_resource_refresh_external(struct vrend_context *ctx,
+                                            struct vrend_resource *res,
+                                            bool force)
+{
+   if (!res || !res->egl_external_shadow || !res->egl_external_id)
+      return;
+
+   if (!force && res->egl_external_refresh_seq == vrend_state.submit_seq)
+      return;
+
+   vrend_blitter_refresh_external(res);
+   vrend_sync_make_current(ctx->sub->gl_context);
+   res->egl_external_refresh_seq = vrend_state.submit_seq;
+}
+
 int vrend_create_surface(struct vrend_context *ctx,
                          uint32_t handle, struct vrend_resource *res,
                          enum virgl_formats format, uint32_t level,
@@ -6065,6 +6096,14 @@ int vrend_draw_vbo(struct vrend_context *ctx,
    if (ctx->ctx_switch_pending)
       vrend_finish_context_switch(ctx);
 
+   for (int type = 0; type < PIPE_SHADER_TYPES; type++) {
+      for (int i = 0; i < sub_ctx->views[type].max_num_views; i++) {
+         struct vrend_sampler_view *view = sub_ctx->views[type].views[i];
+         if (view)
+            vrend_resource_refresh_external(ctx, view->texture, false);
+      }
+   }
+
    vrend_update_frontface_state(sub_ctx);
    if (ctx->sub->stencil_state_dirty)
       vrend_update_stencil_state(sub_ctx);
@@ -8842,6 +8881,37 @@ static int vrend_resource_alloc_texture(struct vrend_resource *gr,
       gr->target = GL_TEXTURE_2D_ARRAY;
    }
 
+   if (image_oes && gr->egl_external_shadow) {
+      /* The driver can only sample this image through samplerExternalOES.
+       * Import it into its own external texture and back gl_id with regular
+       * storage that vrend_blitter_refresh_external() fills from it. */
+      if (gr->target != GL_TEXTURE_2D || pr->nr_samples > 1 || pr->last_level) {
+         virgl_error("external-only EGL image needs a single-level 2D texture\n");
+         return EINVAL;
+      }
+      glGenTextures(1, &gr->egl_external_id);
+      glBindTexture(GL_TEXTURE_EXTERNAL_OES, gr->egl_external_id);
+      glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, (GLeglImageOES) image_oes);
+      GLenum gl_err = glGetError();
+      if (gl_err != GL_NO_ERROR) {
+         virgl_error("glEGLImageTargetTexture2DOES(EXTERNAL_OES) failed: format %d gl error 0x%x\n",
+                     format, gl_err);
+         glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0);
+         glDeleteTextures(1, &gr->egl_external_id);
+         gr->egl_external_id = 0;
+         return EINVAL;
+      }
+      glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+      glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0);
+
+      /* gl_id is an ordinary texture, so don't treat it as an EGL image */
+      gr->storage_bits &= ~VREND_STORAGE_EGL_IMAGE;
+      image_oes = NULL;
+   }
+
    glGenTextures(1, &gr->gl_id);
    glBindTexture(gr->target, gr->gl_id);
 
@@ -8851,6 +8921,10 @@ static int vrend_resource_alloc_texture(struct vrend_resource *gr,
       if (has_bit(gr->storage_bits, VREND_STORAGE_GL_IMMUTABLE) &&
           has_feature(feat_egl_image_storage)) {
          glEGLImageTargetTexStorageEXT(gr->target, (GLeglImageOES) image_oes, NULL);
+         GLenum gl_err = glGetError();
+         if (gl_err != GL_NO_ERROR)
+            virgl_warn("glEGLImageTargetTexStorageEXT failed: format %d gl error 0x%x\n",
+                       format, gl_err);
       } else if (has_feature(feat_egl_image)) {
          gr->storage_bits &= ~VREND_STORAGE_GL_IMMUTABLE;
          assert(gr->target == GL_TEXTURE_2D);
@@ -9053,6 +9127,8 @@ void vrend_renderer_resource_destroy(struct vrend_resource *res)
 {
    if (has_bit(res->storage_bits, VREND_STORAGE_GL_TEXTURE)) {
       glDeleteTextures(1, &res->gl_id);
+      if (res->egl_external_id)
+         glDeleteTextures(1, &res->egl_external_id);
    } else if (has_bit(res->storage_bits, VREND_STORAGE_GL_BUFFER)) {
       glDeleteBuffers(1, &res->gl_id);
       if (res->tbo_tex_id)
@@ -10139,6 +10215,9 @@ static int vrend_renderer_transfer_internal(struct vrend_context *ctx,
    if (!vrend_hw_switch_context(ctx, true))
       return EINVAL;
 
+   if (transfer_mode == VIRGL_TRANSFER_FROM_HOST)
+      vrend_resource_refresh_external(ctx, res, true);
+
    assert(check_transfer_iovec(res, info));
    if (info->iovec && info->iovec_cnt) {
       iov = info->iovec;
@@ -10196,7 +10275,8 @@ int vrend_renderer_transfer_iov(struct vrend_context *ctx,
    }
 
    if (!check_transfer_iovec(res, info)) {
-      if (has_bit(res->storage_bits, VREND_STORAGE_EGL_IMAGE))
+      if (has_bit(res->storage_bits, VREND_STORAGE_EGL_IMAGE) ||
+          res->egl_external_shadow)
          return 0;
       else {
          vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, dst_handle);
@@ -10859,10 +10939,12 @@ void vrend_renderer_resource_copy_region(struct vrend_context *ctx,
       return;
    }
 
+   vrend_resource_refresh_external(ctx, src_res, false);
+
    comp_flags = VREND_COPY_COMPAT_FLAG_ALLOW_COMPRESSED;
-   if (src_res->egl_image)
+   if (src_res->egl_image && !src_res->egl_external_shadow)
       comp_flags |= VREND_COPY_COMPAT_FLAG_ONE_IS_EGL_IMAGE;
-   if (dst_res->egl_image)
+   if (dst_res->egl_image && !dst_res->egl_external_shadow)
       comp_flags ^= VREND_COPY_COMPAT_FLAG_ONE_IS_EGL_IMAGE;
 
    if (has_feature(feat_copy_image) &&
@@ -11398,6 +11480,8 @@ void vrend_renderer_blit(struct vrend_context *ctx,
       return;
    }
 
+   vrend_resource_refresh_external(ctx, src_res, false);
+
    if (info->render_condition_enable == false)
       vrend_pause_render_condition(ctx, true);
 
@@ -11423,9 +11507,9 @@ void vrend_renderer_blit(struct vrend_context *ctx,
                                    info->dst.box.width, info->dst.box.height, info->dst.box.depth,
                                    info->dst.level);
 
-   if (src_res->egl_image)
+   if (src_res->egl_image && !src_res->egl_external_shadow)
       comp_flags |= VREND_COPY_COMPAT_FLAG_ONE_IS_EGL_IMAGE;
-   if (dst_res->egl_image)
+   if (dst_res->egl_image && !dst_res->egl_external_shadow)
       comp_flags ^= VREND_COPY_COMPAT_FLAG_ONE_IS_EGL_IMAGE;
 
    /* resources that don't support texture views but require colorspace conversion
@@ -13583,8 +13667,29 @@ vrend_renderer_pipe_resource_set_type(struct vrend_context *ctx,
 
          gr->storage_bits |= VREND_STORAGE_EGL_IMAGE;
 
+         /* Some drivers (NVIDIA) only support sampling linear dma-bufs via
+          * GL_TEXTURE_EXTERNAL_OES. Import those as external textures and
+          * keep a regular shadow texture in gl_id that is refreshed from the
+          * external image before the resource is read.
+          */
+         gr->egl_external_shadow =
+            virgl_egl_dmabuf_is_external_only(egl, drm_format, args->modifier);
+         if (gr->egl_external_shadow) {
+            gr->egl_external_shadow =
