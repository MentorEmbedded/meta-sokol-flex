diff --git a/src/vrend/vrend_blitter.c b/src/vrend/vrend_blitter.c
index f8291153..1881d8c8 100644
--- a/src/vrend/vrend_blitter.c
+++ b/src/vrend/vrend_blitter.c
@@ -75,6 +75,10 @@ struct vrend_blitter_ctx {
 
    GLuint vbo_id;
    struct blit_coord vertices[4];
+
+   /* [0] identity, [1] BGRA swizzle (GLES only) */
+   GLuint external_prog_id[2];
+   bool external_prog_failed[2];
 };
 
 static struct vrend_blitter_ctx vrend_blit_ctx;
@@ -906,6 +910,161 @@ void vrend_renderer_blit_gl(ASSERTED struct vrend_context *ctx,
    glBindTexture(src_res->target, 0);
 }
 
+/* Shaders used to copy an external-only EGL image (samplerExternalOES) into
+ * the regular shadow texture of the resource. */
+#define VS_EXTERNAL_GL                                   \
+   "#version 330\n"                                      \
+   VS_PASSTHROUGH_BODY
+
+#define VS_EXTERNAL_GLES                                 \
+   "#version 300 es\n"                                   \
+   "precision mediump float;\n"                          \
+   VS_PASSTHROUGH_BODY
+
+#define FS_EXTERNAL_GL                                   \
+   "#version 330\n"                                      \
+   "#extension GL_OES_EGL_image_external : require\n"    \
+   "uniform samplerExternalOES samp;\n"                  \
+   "in vec4 tc;\n"                                       \
+   "out vec4 FragColor;\n"                               \
+   "void main() {\n"                                     \
+   "   FragColor = texture2D(samp, tc.xy);\n"            \
+   "}\n"
+
+#define FS_EXTERNAL_GLES                                         \
+   "#version 300 es\n"                                           \
+   "#extension GL_OES_EGL_image_external_essl3 : require\n"      \
+   "precision mediump float;\n"                                  \
+   "uniform mediump samplerExternalOES samp;\n"                  \
+   "in vec4 tc;\n"                                               \
+   "out vec4 FragColor;\n"                                       \
+   "void main() {\n"                                             \
+   "   FragColor = texture(samp, tc.xy)%s;\n"                    \
+   "}\n"
+
+static GLuint blit_get_external_prog(struct vrend_blitter_ctx *blit_ctx, bool swizzle_bgra)
+{
+   unsigned idx = swizzle_bgra ? 1 : 0;
+
+   if (blit_ctx->external_prog_id[idx] || blit_ctx->external_prog_failed[idx])
+      return blit_ctx->external_prog_id[idx];
+
+   char fs_buf[512];
+   GLint vs_id, fs_id;
+   GLuint prog_id;
+
+   /* On GLES hosts BGRA resources are stored with swapped channels, so the
+    * swizzle has to be applied when writing the shadow texture. */
+   snprintf(fs_buf, sizeof(fs_buf), FS_EXTERNAL_GLES, swizzle_bgra ? ".bgra" : "");
+
+   vs_id = blit_shader_build_and_check(GL_VERTEX_SHADER,
+                                       blit_ctx->use_gles ? VS_EXTERNAL_GLES : VS_EXTERNAL_GL);
+   fs_id = blit_shader_build_and_check(GL_FRAGMENT_SHADER,
+                                       blit_ctx->use_gles ? fs_buf : FS_EXTERNAL_GL);
+   if (!vs_id || !fs_id) {
+      if (vs_id)
+         glDeleteShader(vs_id);
+      if (fs_id)
+         glDeleteShader(fs_id);
+      blit_ctx->external_prog_failed[idx] = true;
+      return 0;
+   }
+
+   prog_id = glCreateProgram();
+   glAttachShader(prog_id, vs_id);
+   glAttachShader(prog_id, fs_id);
+   if (!blit_shader_link_and_check(prog_id)) {
+      prog_id = 0;
+      blit_ctx->external_prog_failed[idx] = true;
+   }
+   glDeleteShader(vs_id);
+   glDeleteShader(fs_id);
+
+   blit_ctx->external_prog_id[idx] = prog_id;
+   return prog_id;
+}
+
+/* Check that the external image copy program can be used. On GLES this is
+ * what GL_OES_EGL_image_external_essl3 provides. Desktop GL has no extension
+ * that covers samplerExternalOES in GLSL 1.30+, and drivers (NVIDIA) accept
+ * it without advertising GL_OES_EGL_image_external, so probe by compiling
+ * the program instead. The caller must restore its own context afterwards. */
+bool vrend_blitter_external_supported(bool swizzle_bgra)
+{
+   struct vrend_blitter_ctx *blit_ctx = &vrend_blit_ctx;
+
+   vrend_renderer_init_blit_ctx(blit_ctx);
+   if (blit_ctx->use_gles &&
+       !epoxy_has_gl_extension("GL_OES_EGL_image_external_essl3"))
+      return false;
+
+   return blit_get_external_prog(blit_ctx, blit_ctx->use_gles && swizzle_bgra) != 0;
+}
+
+/* Refresh the shadow texture (gl_id) of a resource whose dma-buf can only be
+ * sampled as GL_TEXTURE_EXTERNAL_OES (egl_external_id). The copy is done in
+ * the blitter context; the caller must synchronize its own context with
+ * vrend_sync_make_current() afterwards. */
+void vrend_blitter_refresh_external(struct vrend_resource *res)
+{
+   struct vrend_blitter_ctx *blit_ctx = &vrend_blit_ctx;
+   GLuint prog_id;
+   int i;
+
+   vrend_renderer_init_blit_ctx(blit_ctx);
+
+   prog_id = blit_get_external_prog(blit_ctx,
+                                    blit_ctx->use_gles &&
+                                    vrend_format_is_bgra(res->base.format));
+   if (!prog_id) {
+      virgl_error("Blitter: unable to create external image copy program\n");
+      return;
+   }
+
+   glUseProgram(prog_id);
+
+   glBindFramebuffer(GL_FRAMEBUFFER, blit_ctx->fb_id);
+   glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                          GL_TEXTURE_2D, res->gl_id, 0);
+   GLuint buffers = GL_COLOR_ATTACHMENT0;
+   glDrawBuffers(1, &buffers);
+
+   glDisable(GL_SCISSOR_TEST);
+   glDisable(GL_BLEND);
+   glDisable(GL_DEPTH_TEST);
+   glDisable(GL_STENCIL_TEST);
+   glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+   if (!blit_ctx->use_gles)
+      glDisable(GL_FRAMEBUFFER_SRGB);
+
+   glActiveTexture(GL_TEXTURE0);
+   glBindTexture(GL_TEXTURE_EXTERNAL_OES, res->egl_external_id);
+   glUniform1i(glGetUniformLocation(prog_id, "samp"), 0);
+
+   blit_ctx->dst_width = res->base.width0;
+   blit_ctx->dst_height = res->base.height0;
+   blitter_set_rectangle(blit_ctx, 0, 0, res->base.width0, res->base.height0);
+   for (i = 0; i < 4; i++) {
+      blit_ctx->vertices[i].tex.x = (i == 1 || i == 2) ? 1.0f : 0.0f;
+      blit_ctx->vertices[i].tex.y = (i >= 2) ? 1.0f : 0.0f;
+      blit_ctx->vertices[i].tex.z = 0.0f;
+      blit_ctx->vertices[i].tex.w = 1.0f;
+   }
+
+   vrend_set_vertex_param(prog_id);
+   glBufferData(GL_ARRAY_BUFFER, sizeof(blit_ctx->vertices), blit_ctx->vertices, GL_STATIC_DRAW);
+   glDrawArrays(GL_TRIANGLE_FAN, 0, 4);
+
+   glUseProgram(0);
+   glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                          GL_TEXTURE_2D, 0, 0);
+   glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0);
+   /* restore the blitter defaults expected by vrend_renderer_blit_gl */
+   if (!blit_ctx->use_gles)
+      glEnable(GL_FRAMEBUFFER_SRGB);
+   glFlush();
+}
+
 static void delete_program_cb(struct hash_entry *entry)
 {
    glDeleteProgram(pointer_to_uintptr(entry->data));
@@ -916,6 +1075,10 @@ void vrend_blitter_fini(void)
    vrend_blit_ctx.initialised = false;
    if (vrend_blit_ctx.blit_programs)
       _mesa_hash_table_u64_destroy(vrend_blit_ctx.blit_programs, delete_program_cb);
+   for (unsigned i = 0; i < ARRAY_SIZE(vrend_blit_ctx.external_prog_id); i++) {
+      if (vrend_blit_ctx.external_prog_id[i])
+         glDeleteProgram(vrend_blit_ctx.external_prog_id[i]);
+   }
    vrend_clicbs->destroy_gl_context(vrend_blit_ctx.gl_context);
    memset(&vrend_blit_ctx, 0, sizeof(vrend_blit_ctx));
 }
diff --git a/src/vrend/vrend_blitter.h b/src/vrend/vrend_blitter.h
index 91e24352..9c457d11 100644
--- a/src/vrend/vrend_blitter.h
+++ b/src/vrend/vrend_blitter.h
@@ -186,6 +186,8 @@ void vrend_renderer_blit_gl(ASSERTED struct vrend_context *ctx,
                             struct vrend_resource *src_res,
                             struct vrend_resource *dst_res,
