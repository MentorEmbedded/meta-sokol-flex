# kind, whether express or implied.

packages="python39 \
          python3-setuptools \
          patch diffstat git bzip2 tar \
          gzip gawk chrpath wget cpio perl file which \
          rsync rpcgen \
          zstd lz4"

if grep -Pq '^VERSION_ID=(?:|")8\.' /etc/os-release; then
    # Following packages require sourcing their environment which is done through
    # setup-environment script:
    # - `source scl_source enable gcc-toolset-9`
    # - `source scl_source enable make43`
    packages+=" make43 gcc-toolset-9 scl-utils"
else
    packages+=" make gcc gcc-c++"
fi

set -e

if [ "$(id -u)" != "0" ]; then
    echo "Verifying access to sudo, please enter your password if prompted."
    if ! sudo -v; then
        echo >&2 "Could not use sudo, exiting"
        exit 1
    fi
    exec sudo "$0" "$@"
fi

if grep -Pq '^ID=(?:|")rocky(?:|")' /etc/os-release; then
    echo "Enabling any required repos"
    
    if grep -Pq '^VERSION_ID=(?:|")8\.' /etc/os-release; then
        # Enable repo required for rpcgen package
        dnf config-manager --set-enabled powertools
    fi
fi

echo "Installing packages required to build Innexis Linux"
dnf install --assumeyes "$@" $packages || {
    echo >&2 "Error installing our required packages, aborting"
    exit 1
}

# Add symbolic link for the required version of python on Rocky-8
if grep -Pq '^VERSION_ID=(?:|")8\.' /etc/os-release; then
    ln -sfn /usr/bin/python3.9 /usr/local/bin/python3
fi

# Rocky/RHEL ships tar 1.34 which crashes on xattr extraction with SELinux enabled.
# Yocto requires tar >= 1.35. Build from source since no repo provides a newer version.
TAR_VER=$(tar --version | awk 'NR==1{print $NF}')
TAR_NEED="1.35"
if ! printf '%s\n%s\n' "$TAR_NEED" "$TAR_VER" | sort -V -C 2>/dev/null; then
    echo "tar $TAR_VER is too old for Yocto on SELinux-enabled hosts; building tar $TAR_NEED"
    TAR_SRC="tar-$TAR_NEED"
    TMP=$(mktemp -d)
    curl -fsSL "https://ftp.gnu.org/gnu/tar/$TAR_SRC.tar.xz" -o "$TMP/$TAR_SRC.tar.xz"
    tar -C "$TMP" -xJf "$TMP/$TAR_SRC.tar.xz"
    (cd "$TMP/$TAR_SRC" && FORCE_UNSAFE_CONFIGURE=1 ./configure --prefix=/usr/local && make -j"$(nproc)" && make install)
    rm -rf "$TMP"
    echo "Installed $(/usr/local/bin/tar --version | awk 'NR==1{print}')"
fi

echo "Setup complete"
